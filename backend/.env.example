# Copy to backend/.env. Everything is optional for local testing.

# development | production. Production requires SECRET_KEY and never shows OTP codes on screen.
SCHEMESETU_ENV=development
# SECRET_KEY=change-me-to-a-long-random-string

# Database: SQLite file by default (backend/storage/schemesetu.db). Any SQLAlchemy URL works:
#   PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/schemesetu   (pip install "psycopg[binary]")
#   MySQL:      mysql+pymysql://user:pass@localhost:3306/schemesetu        (pip install pymysql)
# DATABASE_URL=

# AI chat assistant. Free option: create a key at https://console.groq.com/keys
# Without a key the assistant still works, using the built-in rule-based parser.
# GROQ_API_KEY=
# Any OpenAI-compatible API works instead, e.g. Ollama running locally:
#   LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=gpt-oss:20b   LLM_API_KEY=ollama
# Understanding uses LLM_MODEL; replies use LLM_REPLY_MODEL (users read these, so use the stronger model).
# On Groq each model has its own free per-minute limit, so two models double the room.
# LLM_MODEL=openai/gpt-oss-20b
# LLM_REPLY_MODEL=openai/gpt-oss-120b

# Fictional phone numbers with a fixed OTP, for testing login without SMS/WhatsApp (like Firebase test numbers).
# Codes are never shown in the app. Format: number:code,number:code. Remove for production.
# OTP_TEST_NUMBERS=9999999999:123456

# WhatsApp Cloud API (Meta). Without these, OTPs and alerts are printed to the server console.
# Business-initiated messages need approved templates and are charged per message by Meta.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=schemesetu_otp
# WHATSAPP_ALERT_TEMPLATE=schemesetu_new_scheme

# Public site address used in WhatsApp alert links.
# PUBLIC_URL=http://localhost:3000
